<math xmlns="http://www.w3.org/1998/Math/MathML" display="block">
  <mi mathvariant="bold-italic">{VARIABLE}</mi>
  <mo stretchy="false">(</mo>
  <mi mathvariant="italic">t</mi>
  <mo stretchy="false">)</mo>
  <mo>=</mo>
  <mn>{INITIAL}</mn>
  <mo>×</mo>
  <msup>
    <mrow>
      <mo stretchy="false">(</mo>
      <mn>{FACTOR}</mn>
      <mo stretchy="false">)</mo>
    </mrow>
    <mi mathvariant="italic">t</mi>
  </msup>
</math>
